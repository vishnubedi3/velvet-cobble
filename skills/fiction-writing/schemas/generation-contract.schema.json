{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "generation-contract.schema.json",
  "title": "GenerationContract",
  "type": "object",
  "required": [
    "contract_id",
    "canon_state_id",
    "branch_context",
    "must_remain_unchanged",
    "permitted_creative_space",
    "forbidden_assumptions",
    "source_hashes"
  ],
  "additionalProperties": false,
  "properties": {
    "contract_id": { "type": "string" },
    "canon_state_id": { "type": "string" },
    "branch_context": { "type": "object" },
    "evaluated_at": { "type": "string" },
    "locked": { "type": "boolean" },
    "lock_hash": { "type": "string" },
    "must_remain_unchanged": { "type": "array", "items": { "type": "object" } },
    "character_constraints": { "type": "array", "items": { "type": "object" } },
    "relationship_constraints": { "type": "array", "items": { "type": "object" } },
    "timeline_constraints": { "type": "array", "items": { "type": "object" } },
    "knowledge_constraints": { "type": "array", "items": { "type": "object" } },
    "location_constraints": { "type": "array", "items": { "type": "object" } },
    "political_faction_constraints": { "type": "array", "items": { "type": "object" } },
    "causal_constraints": { "type": "array", "items": { "type": "object" } },
    "world_rules": { "type": "array", "items": { "type": "object" } },
    "permitted_creative_space": {
      "type": "array",
      "items": { "type": ["string", "object"] }
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "uncertainties": { "type": "array", "items": { "type": "string" } },
    "forbidden_assumptions": { "type": "array", "items": { "type": "string" } },
    "authorized_changes": { "type": "array", "items": { "type": "object" } },
    "working_canon_context": { "type": "object" },
    "constraint_bands": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "HARD_CONSTRAINTS": { "type": "array", "items": { "type": "object" } },
        "SOFT_CONTEXT": { "type": "array", "items": { "type": "object" } },
        "CURRENT_AUTHORIAL_DIRECTION": { "type": "array", "items": { "type": "object" } },
        "PROVISIONAL_MATERIAL": { "type": "array", "items": { "type": "object" } },
        "FORBIDDEN_ASSUMPTIONS": { "type": "array", "items": { "type": "string" } }
      }
    },
    "source_status": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ESTABLISHED_CANON": { "type": "array", "items": { "type": "object" } },
        "CURRENT_WORKING_DEVELOPMENT": { "type": "array", "items": { "type": "object" } },
        "CANON_CLARIFICATIONS": { "type": "array", "items": { "type": "object" } },
        "AUTHORIAL_DIRECTION": { "type": "array", "items": { "type": "object" } },
        "PROVISIONAL": { "type": "array", "items": { "type": "object" } },
        "CONFLICTS": { "type": "array", "items": { "type": "object" } },
        "OPEN_QUESTIONS": { "type": "array", "items": { "type": "object" } }
      }
    },
    "source_hashes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "hash"],
        "properties": {
          "path": { "type": "string" },
          "hash": { "type": "string" }
        }
      }
    }
  }
}
