{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verification-report.schema.json",
  "title": "VerificationReport",
  "type": "object",
  "required": [
    "request_id",
    "canon_state_id",
    "checks_performed",
    "findings",
    "decision"
  ],
  "additionalProperties": false,
  "properties": {
    "request_id": { "type": "string" },
    "canon_state_id": { "type": "string" },
    "branch_context": { "type": "object" },
    "evaluated_at": { "type": "string" },
    "layer": {
      "type": "string",
      "enum": ["pre_generation", "post_generation"]
    },
    "pre_generation_contract_id": { "type": ["string", "null"] },
    "lock_hash": { "type": ["string", "null"] },
    "admitted": { "type": "boolean" },
    "must_re_resolve": { "type": "boolean" },
    "relevant_sources": {
      "type": "array",
      "items": { "type": "object" }
    },
    "constraints_extracted": {
      "type": "array",
      "items": { "type": "object" }
    },
    "checks_performed": {
      "type": "array",
      "items": { "type": "string" }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["class"],
        "properties": {
          "class": { "type": "string" },
          "severity": { "type": "string" },
          "band": {
            "type": "string",
            "enum": [
              "informational",
              "low",
              "warning",
              "significant",
              "blocking",
              "canon_change"
            ]
          },
          "summary": { "type": "string" },
          "evidence": { "type": "object" }
        }
      }
    },
    "decision": {
      "type": "string",
      "enum": [
        "PASS",
        "PASS_WITH_WARNINGS",
        "REQUIRES_CLARIFICATION",
        "BLOCK",
        "CANON_CHANGE_REQUIRED"
      ]
    },
    "invalidation": { "type": ["object", "null"] },
    "contract_id": { "type": ["string", "null"] },
    "splash_classifications": { "type": "array", "items": { "type": "object" } },
    "working_canon_context": { "type": "object" }
  }
}
